+// Independent, synced action ledger for the isolated research profile only.
+// A failed ledger write terminates the process rather than hiding lost evidence.
+func journalAction(id, kind, orderID, messageID string) {
+	path := os.Getenv("porv_ACTION_JOURNAL")
+	if path == "" {
+		return
+	}
+	data, err := json.Marshal(map[string]string{"id": id, "type": kind, "order_id": orderID, "message_id": messageID})
+	if err != nil {
+		panic(err)
+	}
+	f, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0600)
+	if err != nil {
+		panic(err)
+	}
+	if _, err = f.Write(append(data, '\n')); err != nil {
+		panic(err)
+	}
+	if err = f.Sync(); err != nil {
+		panic(err)
+	}
+	if err = f.Close(); err != nil {
+		panic(err)
+	}
+}
